# The plan server reads this. Never commit a real key, and never put it in any
# file under src/ — that ships to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Optional
PORT=8787
CORS_ORIGIN=http://localhost:5173


# --- Strava -------------------------------------------------------------
# https://www.strava.com/settings/api — create an application, then copy its
# client ID and secret here. The secret has the same rule as the key above: it
# stays on the server. Note that since June 2026 Strava's standard developer
# tier requires an active Strava subscription on the account that owns the
# application.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Where Strava sends the athlete back. The domain must match the
# "Authorization Callback Domain" set on the Strava application (`localhost`
# in development), and the port must match PORT above.
STRAVA_REDIRECT_URI=http://localhost:8787/api/strava/callback

# Where the callback page links back to — the app, not the server.
STRAVA_APP_ORIGIN=http://localhost:5173

# A string you invent. Strava echoes it back when it validates the webhook
# callback, and the server refuses anything that does not match.
STRAVA_VERIFY_TOKEN=

# Where the athlete's tokens are kept, relative to the repo root. The file is
# written 0600 and is gitignored — it is a credential, not configuration.
STRAVA_TOKEN_STORE=.strava.json

# Strava's MCP server, which the coach attaches to its Claude call so the model
# can read past the aggregates the sync kept. Only override this to point at a
# proxy; the default is Strava's own.
# STRAVA_MCP_URL=https://mcp.strava.com/mcp
