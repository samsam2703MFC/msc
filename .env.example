# The plan server reads this. Never commit a real key, and never put it in any
# file under src/ — that ships to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Optional
PORT=8787
CORS_ORIGIN=http://localhost:5173


# --- Strava -------------------------------------------------------------
# https://www.strava.com/settings/api — create an application, then copy its
# client ID and secret here. The secret has the same rule as the key above: it
# stays on the server. Note that since June 2026 Strava's standard developer
# tier requires an active Strava subscription on the account that owns the
# application.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Where Strava sends the athlete back. The domain must match the
# "Authorization Callback Domain" set on the Strava application (`localhost`
# in development), and the port must match PORT above.
STRAVA_REDIRECT_URI=http://localhost:8787/api/strava/callback

# Where the callback page links back to — the app, not the server.
STRAVA_APP_ORIGIN=http://localhost:5173

# A string you invent. Strava echoes it back when it validates the webhook
# callback, and the server refuses anything that does not match.
STRAVA_VERIFY_TOKEN=

# Les jetons Strava vivent en base depuis que la base existe — msc_strava_compte,
# chiffrés avec MSC_SECRET_KEY. Il n'y a plus de fichier de jetons.

# Strava's MCP server, which the coach attaches to its Claude call so the model
# can read past the aggregates the sync kept. Only override this to point at a
# proxy; the default is Strava's own.
# STRAVA_MCP_URL=https://mcp.strava.com/mcp


# --- La base ------------------------------------------------------------
# MySQL 8 (ou MariaDB 10.11). `npm run db:migrate` crée la base si elle
# n'existe pas, `npm run db:seed` y charge le classeur.
MSC_DB_HOST=127.0.0.1
MSC_DB_PORT=3306
MSC_DB_USER=msc
MSC_DB_PASSWORD=
MSC_DB_NAME=msc
# Une URL complète prend le pas sur les cinq variables ci-dessus.
# MSC_DATABASE_URL=mysql://msc:secret@127.0.0.1:3306/msc
# Un socket Unix, si le serveur est sur la même machine.
# MSC_DB_SOCKET=/var/run/mysqld/mysqld.sock

# Chiffre les jetons Strava avant qu'ils touchent la base. 32 octets, en
# base64 ou en hexadécimal. Elle ne va PAS dans la base : celui qui obtient
# l'une ne doit pas obtenir l'autre. Génère-la avec
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# La perdre, c'est délier tous les comptes Strava et recommencer.
MSC_SECRET_KEY=

# Où atterrissent les photos envoyées par l'app. La base ne garde que le
# chemin relatif, jamais le fichier.
MSC_PHOTOS_DIR=./var/photos

# Court-circuite l'authentification en développement : le serveur répond au nom
# de cet athlète sans cookie. Refusé quand NODE_ENV=production.
# MSC_ATHLETE_ID=1
